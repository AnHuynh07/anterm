# Copy to .env and adjust. All vars are also settable as CLI flags (see `anterm --help`).

# Master secret: encrypts stored SSH credentials AND signs session cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if lost, all stored SSH credentials become undecryptable.
ANTERM_APP_SECRET=change-me-please-32-bytes-minimum-secret

# SQLite database file (directory must be writable).
ANTERM_DB_URL=./data/anterm.sqlite

# HTTP listener
ANTERM_HOST=0.0.0.0
ANTERM_PORT=3000
ANTERM_BASE=/

# First-run admin bootstrap (only used when the users table is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Optional TLS (otherwise run behind a reverse proxy)
# ANTERM_SSL_KEY=/certs/key.pem
# ANTERM_SSL_CERT=/certs/cert.pem

# Optional: comma-separated host allowlist for SSH targets (empty = allow any)
# ANTERM_ALLOW_HOSTS=10.0.0.5,db.internal

# Optional WeTTY-style ad-hoc SSH defaults (enables the login-less /connect flow).
# ANTERM_SSH_HOST=127.0.0.1
# ANTERM_SSH_PORT=22
# ANTERM_SSH_USER=
# ANTERM_SSH_AUTH=password,publickey
# ANTERM_SSH_COMMAND=
